# AI Services Environment Variables
# Copy this to .env.local and adjust if needed

# Disable PaddlePaddle external model source check (prevents network calls on startup)
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# Disable oneDNN (MKL-DNN) to prevent CPU optimization warnings on some hardware
FLAGS_use_mkldnn=0

# Server configuration
HOST=0.0.0.0
PORT=8000

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# LLM Parser Configuration (Supports Ollama, Groq, OpenAI, OpenRouter, vLLM)
# Local Ollama:
LLM_API_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=llama3
LLM_API_KEY=EMPTY

# Example Cloud Groq (Fast & Free Tier):
# LLM_API_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL_NAME=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_your_key_here

# Example OpenAI:
# LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini
# LLM_API_KEY=sk-your_key_here
