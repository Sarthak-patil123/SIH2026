// Prisma Schema for Fake Identity Screening
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OFFICER
  ADMIN
}

enum CaseStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  FLAGGED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  role           Role     @default(OFFICER)
  passwordHash   String?  // bcrypt hash — nullable so legacy rows aren't broken
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cases          Case[]   @relation("OfficerCases")
  reviewedCases  Case[]   @relation("CaseReviewer")
}

model Case {
  id            String      @id @default(uuid())
  title         String
  personName    String?     // name of the person being verified
  status        CaseStatus  @default(PENDING)
  riskScore     Float       @default(0.0)
  riskLevel     RiskLevel   @default(LOW)
  officerId     String
  officer       User        @relation("OfficerCases", fields: [officerId], references: [id])
  reviewedById  String?     // Admin who reviewed/closed this case
  reviewer      User?       @relation("CaseReviewer", fields: [reviewedById], references: [id])
  documents     Document[]
  auditLogs     AuditLog[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Document {
  id             String   @id @default(uuid())
  caseId         String
  case           Case     @relation(fields: [caseId], references: [id])
  fileName       String
  fileUrl        String
  docType        String
  sha256Hash     String
  ocrData        Json?
  ocrConfidence  Float?   // extracted OCR confidence score (0–100); <75 = low confidence
  tamperResult   Json?
  faceResult     Json?
  createdAt      DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(uuid())
  caseId        String
  case          Case     @relation(fields: [caseId], references: [id])
  action        String
  actorId       String
  details       Json
  eventHash     String
  txId          String?  // Hyperledger Fabric Transaction ID
  blockNumber   Int?
  createdAt     DateTime @default(now())
}
